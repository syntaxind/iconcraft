# Copy to .env.local and fill in. Never commit real keys.

# Required for AI features (Style DNA analysis + AI icon generation).
# Get one at https://aistudio.google.com/apikey
# Without it the app still works offline with the built-in icon generator.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional overrides
# PORT=3000
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# RATE_LIMIT_PER_MIN=30
